{
  "expo": {
    "name": "AI Phishing Detector",
    "slug": "ai-phishing-detector-mobile",
    "version": "1.0.0",
    "description": "Şüpheli bağlantıları açmadan önce analiz eden mobil güvenlik uygulaması.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiphishingdetector",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiphishingdetector.mobile"
    },
    "android": {
      "package": "com.aiphishingdetector.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "QR kodlarla şüpheli bağlantıları tarayabilmek için kameraya erişim izni gereklidir.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}